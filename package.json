{
  "name": "project-context-manager-next",
  "version": "3.0.0-alpha.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-extension.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "package:vsix": "npm run build && node scripts/package-vsix.mjs",
    "test": "vitest run",
    "cli": "tsx packages/cli/src/index.ts",
    "test:extension": "node scripts/test-extension.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "package:release": "npm run package:vsix && node scripts/package-release.mjs",
    "acceptance:scale": "npm run build && node scripts/scale-acceptance.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.106.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3",
    "yauzl": "3.4.0",
    "yazl": "2.5.1"
  }
}
